{
  "backend": "rpent",
  "call_budget": {
    "max_calls": 100,
    "max_reserved_tokens": 6500000
  },
  "checkpoint_id": "REPLACE_WITH_EXACT_HF_ID_AND_REVISION",
  "checkpoint_sha256": "REPLACE_WITH_WEIGHT_MANIFEST_SHA256",
  "control_hz": 20,
  "cuda_device": 0,
  "enable_policy": true,
  "governor": {
    "allow_substitution": true,
    "check_every_steps": 10,
    "min_progress_m": 0.001,
    "stage_warmup_steps": 20,
    "stall_checks": 4
  },
  "information_profile": "sensor",
  "max_decisions": 40,
  "max_infrastructure_errors": 1,
  "max_steps": 520,
  "max_vla_calls": 100,
  "max_wall_s": 1800,
  "mode": "nominal",
  "planner": {
    "extra_request": {
      "temperature": 0
    },
    "input_token_reservation": 60000,
    "kind": "api",
    "max_output_tokens": 2048,
    "timeout_s": 120
  },
  "record_video": true,
  "rpent_root": "external/RPent",
  "vla_endpoint": "http://127.0.0.1:8911"
}
